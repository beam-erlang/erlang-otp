# Native wxWidgets is selected through its installed CMake package. No Unix
# wx-config program or sibling dependency build directory participates.
include(CheckCXXSourceCompiles)
include(CheckCXXCompilerFlag)
include(CMakePushCheckState)
set(OTP_WX_ROOT "$ENV{OTP_WX_ROOT}" CACHE PATH "Explicit installed Windows wxWidgets prefix")
set(OTP_WX_LIB_DIR "$ENV{OTP_WX_LIB_DIR}" CACHE PATH "Optional selected Windows wxWidgets library directory")
if(NOT IS_ABSOLUTE "${OTP_WX_ROOT}" OR NOT IS_DIRECTORY "${OTP_WX_ROOT}")
    message(FATAL_ERROR "Set OTP_WX_ROOT to an absolute installed Windows wxWidgets prefix")
endif()
set(wxWidgets_USE_STATIC TRUE)
find_package(wxWidgets 3.2 CONFIG REQUIRED COMPONENTS base core adv html xrc xml aui gl stc webview
    PATHS "${OTP_WX_ROOT}/lib/cmake/wxWidgets" NO_DEFAULT_PATH)
set(_wx_resolved_link_items ${wxWidgets_LIBRARIES})
set(_wx_gl_libraries opengl32 glu32)
set(_wx_definitions __WXMSW__ UNICODE _UNICODE NOMINMAX WXE_WEBVIEW=1 HAVE_GL_SUPPORT=1)
set(_wx_c_options)
set(_wx_cxx_options)
set(OTP_WX_FORCED_DEBUG FALSE)
set(OTP_WX_HAS_WEBVIEW TRUE)
set(OTP_WX_SELECTED_CONFIG "msvc-x64-static-${CMAKE_BUILD_TYPE}")
set(OTP_WX_VERSION_FULL "${wxWidgets_VERSION}")
set(OTP_WX_LINKAGE static)
set(OTP_WX_COMPONENTS "base,core,adv,html,xrc,xml,aui,gl,stc,webview")
cmake_push_check_state(RESET)
set(CMAKE_TRY_COMPILE_CONFIGURATION "${CMAKE_BUILD_TYPE}")
set(CMAKE_REQUIRED_LIBRARIES ${_wx_resolved_link_items})
unset(OTP_WX_WINDOWS_CAN_LINK CACHE)
check_cxx_source_compiles("#include <wx/wx.h>\n#include <wx/glcanvas.h>\n#include <wx/webview.h>\n#include <wx/stc/stc.h>\n#if !wxUSE_UNICODE || !wxUSE_GLCANVAS || !wxUSE_POSTSCRIPT || !wxUSE_WEBVIEW_EDGE || !WXWIN_COMPATIBILITY_3_0\n#error Required Windows wxWidgets features disabled\n#endif\nint main() { return wxWebView::New() == nullptr; }" OTP_WX_WINDOWS_CAN_LINK)
cmake_pop_check_state()
if(NOT OTP_WX_WINDOWS_CAN_LINK)
    message(FATAL_ERROR "Selected Windows wxWidgets lacks required Unicode, GL, PostScript, WebView2 or compatibility features, or uses an incompatible toolchain/CRT")
endif()

function(_otp_wx_windows_quote output value)
    string(REPLACE "\\" "/" _value "${value}")
    string(REPLACE "\"" "\\\"" _value "${_value}")
    set(${output} "\"${_value}\"" PARENT_SCOPE)
endfunction()
file(REAL_PATH "${wxWidgets_CONFIG}" _selector)
file(SHA256 "${_selector}" _selector_hash)
set(_receipt "{\"schema_version\":1,\"unicode\":true,\"webview\":true,\"linkage\":\"static\"}")
file(STRINGS "${PROJECT_SOURCE_DIR}/UPSTREAM_COMMIT" _pin LIMIT_COUNT 1)
foreach(_pair "upstream_commit|${_pin}" "system|Windows" "architecture|AMD64"
        "version|${OTP_WX_VERSION_FULL}" "selected_config|${OTP_WX_SELECTED_CONFIG}"
        "selector|${wxWidgets_CONFIG}" "selector_real_path|${_selector}" "selector_sha256|${_selector_hash}")
    string(REPLACE "|" ";" _parts "${_pair}")
    list(GET _parts 0 _key)
    list(GET _parts 1 _value)
    _otp_wx_windows_quote(_quoted "${_value}")
    string(JSON _receipt SET "${_receipt}" "${_key}" "${_quoted}")
endforeach()
# Bind the entire selected installed library/header closure, including the
# configuration-specific setup header. Native link probes verify compatibility.
file(GLOB_RECURSE _wx_artifacts LIST_DIRECTORIES FALSE
    "${OTP_WX_ROOT}/lib/*.lib" "${OTP_WX_ROOT}/include/wx/setup.h"
    "${OTP_WX_ROOT}/lib/*/wx/setup.h" "${OTP_WX_ROOT}/include/wx/version.h")
set(_artifacts "[]")
set(_index 0)
foreach(_file IN LISTS _wx_artifacts)
    file(REAL_PATH "${_file}" _real)
    file(SHA256 "${_real}" _hash)
    _otp_wx_windows_quote(_path_json "${_file}")
    _otp_wx_windows_quote(_real_json "${_real}")
    string(JSON _artifacts SET "${_artifacts}" ${_index}
        "{\"path\":${_path_json},\"real_path\":${_real_json},\"sha256\":\"${_hash}\"}")
    math(EXPR _index "${_index} + 1")
endforeach()
if(_index EQUAL 0)
    message(FATAL_ERROR "Selected wxWidgets installation has no static library/header closure")
endif()
string(JSON _receipt SET "${_receipt}" artifacts "${_artifacts}")
file(WRITE "${PROJECT_BINARY_DIR}/wx-selection.json" "${_receipt}\n")
file(WRITE "${PROJECT_BINARY_DIR}/wx-selection.txt" "selector=${wxWidgets_CONFIG}\nselected_config=${OTP_WX_SELECTED_CONFIG}\n")
