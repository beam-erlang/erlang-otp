# One OTP-owned built-in inventory for product and private build hosts.
find_package(Python3 3.9 REQUIRED COMPONENTS Interpreter)
find_package(Perl REQUIRED)
set(_preloads erl_init init prim_buffer prim_eval prim_inet prim_file zlib
    socket_registry prim_socket prim_net prim_zip erl_prim_loader erl_tracer)
set(_preload_sources)
set(_preload_outputs)
otp_application_version(erts _erts_version)
set(_preload_relative "lib/erts-${_erts_version}/ebin")
foreach(_module IN LISTS _preloads)
    if(_module STREQUAL prim_eval)
        set(_extension S)
    else()
        set(_extension erl)
    endif()
    list(APPEND _preload_sources "${PROJECT_SOURCE_DIR}/erts/preloaded/src/${_module}.${_extension}")
    list(APPEND _preload_outputs "${PROJECT_BINARY_DIR}/otp/${_preload_relative}/${_module}.beam")
endforeach()
list(LENGTH _preloads _count)
set(_assets "/* Generated from OTP policy and the selected public SDK. */\n#include \"sdk_selection.h\"\n#define OTP_PRELOAD_COUNT ${_count}\nextern const beam_module_spec otp_preloads[OTP_PRELOAD_COUNT];\n")
set(_nifs prim_file prim_buffer prim_socket prim_net erl_tracer zlib prim_tty zstd)
set(_otp_linked_native otp_socket_backend)
foreach(_module IN LISTS _nifs)
    string(APPEND _assets "extern struct enif_entry_t *otp_${_module}_nif_init(void);\n")
    if(TARGET "otp_${_module}_nif")
        list(APPEND _otp_linked_native "otp_${_module}_nif")
    endif()
endforeach()
string(APPEND _assets "static const beam_builtin_nif otp_nifs[] = {\n")
foreach(_module IN LISTS _nifs)
    string(APPEND _assets "    {sizeof(beam_builtin_nif), \"${_module}\", OTP_SDK_BUILD_ID, otp_${_module}_nif_init, 0},\n")
endforeach()
list(LENGTH _nifs _count)
string(APPEND _assets "};\n#define OTP_NIF_COUNT ${_count}\n")
set(_drivers)
foreach(_protocol IN LISTS OTP_INET_PROTOCOLS)
    list(APPEND _drivers "${_protocol}_inet")
endforeach()
list(APPEND _drivers ram_file_drv)
if(WIN32)
    list(APPEND _drivers registry)
endif()
foreach(_driver IN LISTS _drivers)
    list(APPEND _otp_linked_native "otp_${_driver}_driver")
    string(APPEND _assets "extern struct erl_drv_entry *${_driver}_driver_init(void);\n")
endforeach()
string(APPEND _assets "static const beam_builtin_driver otp_drivers[] = {\n")
foreach(_driver IN LISTS _drivers)
    set(_name "${_driver}")
    if(_driver STREQUAL registry)
        set(_name registry__drv__)
    endif()
    string(APPEND _assets "    {sizeof(beam_builtin_driver), \"${_name}\", OTP_SDK_BUILD_ID, ${_driver}_driver_init, 0},\n")
endforeach()
list(LENGTH _drivers _count)
string(APPEND _assets "};\n#define OTP_DRIVER_COUNT ${_count}\n#define OTP_CHILD_HELPER \"erts-${_erts_version}/bin/erl_child_setup\"\n")
file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/otp_host_assets.h" CONTENT "${_assets}" @ONLY)
file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/otp_host_version.h"
    CONTENT "/* Generated from the OTP application version table. */\n#define OTP_ERTS_VERSION \"${_erts_version}\"\n" @ONLY)

function(otp_add_host target preload_directory)
    if(NOT TARGET otp_host_objects)
        add_library(otp_host_objects OBJECT "${PROJECT_SOURCE_DIR}/tools/otp_host.c")
        add_library(otp_host_inputs OBJECT "${PROJECT_SOURCE_DIR}/tools/otp_host_inputs.c")
        foreach(_objects IN ITEMS otp_host_objects otp_host_inputs)
            target_compile_features("${_objects}" PRIVATE c_std_11)
            target_include_directories("${_objects}" PRIVATE "${PROJECT_BINARY_DIR}/generated")
            target_link_libraries("${_objects}" PRIVATE BEAM::RuntimeStatic)
            if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
                target_compile_options("${_objects}" PRIVATE -Wall -Wextra -Werror)
            endif()
        endforeach()
    endif()
    set(_embedded "${PROJECT_BINARY_DIR}/generated/${target}_preloads.c")
    add_custom_command(OUTPUT "${_embedded}"
        COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/embed_preloads.py"
            --directory "${preload_directory}" --output "${_embedded}"
            --perl "${PERL_EXECUTABLE}"
            --generator "${PROJECT_SOURCE_DIR}/erts/emulator/utils/make_preload" ${_preloads}
        DEPENDS "${PROJECT_SOURCE_DIR}/tools/embed_preloads.py"
            "${PROJECT_SOURCE_DIR}/erts/emulator/utils/make_preload" ${ARGN}
        COMMENT "Embedding canonical preloads into ${target}" VERBATIM)
    add_executable("${target}" $<TARGET_OBJECTS:otp_host_objects>
        $<TARGET_OBJECTS:otp_host_inputs> "${_embedded}")
    target_link_libraries("${target}" PRIVATE BEAM::RuntimeStatic ${_otp_linked_native})
    if(MINGW)
        target_link_options("${target}" PRIVATE -municode)
    endif()
endfunction()
