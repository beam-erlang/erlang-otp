if(WIN32)
    file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/otp_inet_config.h" CONTENT
        "/* Native Winsock protocol drivers. */\n#define HAVE_SDKDDKVER_H 1\n#define HAVE_IN6 1\n#define HAVE_IN6ADDR_ANY 1\n#define HAVE_IN6ADDR_LOOPBACK 1\n#define HAVE_DECL_IPV6_V6ONLY 1\n#define HAVE_MULTICAST_SUPPORT 1\n#define NO_SA_LEN 1\n" @ONLY)
    return()
endif()
include(CMakePushCheckState)
include(CheckIncludeFile)
include(CheckSymbolExists)
include(CheckCSourceCompiles)
cmake_push_check_state(RESET)
set(CMAKE_REQUIRED_DEFINITIONS -D_GNU_SOURCE -D_FILE_OFFSET_BITS=64)
set(_inet_config "/* OTP-owned protocol-driver platform probes. */\n")
macro(otp_inet_probe_symbol symbol headers define)
    check_symbol_exists("${symbol}" "${headers}" "OTP_INET_${define}")
    if(OTP_INET_${define})
        string(APPEND _inet_config "#define ${define} 1\n")
    endif()
endmacro()
macro(otp_inet_probe_source source define)
    check_c_source_compiles("${source}" "OTP_INET_${define}")
    if(OTP_INET_${define})
        string(APPEND _inet_config "#define ${define} 1\n")
    endif()
endmacro()
foreach(_header IN ITEMS unistd.h sys/uio.h sys/un.h sys/ioctl.h sys/sockio.h
        net/if_dl.h netpacket/packet.h ifaddrs.h arpa/nameser.h sched.h)
    string(TOUPPER "${_header}" _name)
    string(REGEX REPLACE "[/.-]" "_" _name "${_name}")
    check_include_file("${_header}" "OTP_INET_HAVE_${_name}")
    if(OTP_INET_HAVE_${_name})
        string(APPEND _inet_config "#define HAVE_${_name} 1\n")
    endif()
endforeach()
foreach(_required UNISTD_H SYS_UIO_H SYS_IOCTL_H)
    if(NOT OTP_INET_HAVE_${_required})
        message(FATAL_ERROR "OTP Linux protocol drivers require ${_required}")
    endif()
endforeach()
otp_inet_probe_symbol(getifaddrs "sys/types.h;ifaddrs.h" HAVE_GETIFADDRS)
otp_inet_probe_symbol(strncasecmp "strings.h" HAVE_STRNCASECMP)
if(APPLE)
    check_symbol_exists(sendfile "sys/types.h;sys/socket.h;sys/uio.h" OTP_INET_HAVE_DARWIN_SENDFILE)
    if(OTP_INET_HAVE_DARWIN_SENDFILE)
        string(APPEND _inet_config "#define HAVE_SENDFILE 1\n")
    endif()
else()
    otp_inet_probe_symbol(sendfile "sys/types.h;sys/sendfile.h" HAVE_SENDFILE)
endif()
otp_inet_probe_symbol(setns "sched.h" HAVE_SETNS)
otp_inet_probe_symbol(SO_BSDCOMPAT "sys/socket.h" HAVE_SO_BSDCOMPAT)
otp_inet_probe_symbol(IPV6_V6ONLY "sys/types.h;sys/socket.h;netinet/in.h" HAVE_DECL_IPV6_V6ONLY)
foreach(_symbol IN ITEMS in6addr_any in6addr_loopback IN6ADDR_ANY_INIT IN6ADDR_LOOPBACK_INIT)
    string(TOUPPER "${_symbol}" _name)
    otp_inet_probe_symbol("${_symbol}" "sys/types.h;sys/socket.h;netinet/in.h" "HAVE_${_name}")
    if(OTP_INET_HAVE_${_name})
        string(APPEND _inet_config "#define HAVE_DECL_${_name} 1\n")
    endif()
endforeach()
otp_inet_probe_source("#include <sys/types.h>\n#include <sys/socket.h>\nint main(void) { socklen_t n=0; return (int)n; }" HAVE_SOCKLEN_T)
otp_inet_probe_source("#include <netinet/in.h>\nint main(void) { struct in6_addr a; return sizeof(a)!=16; }" HAVE_IN6)
otp_inet_probe_source("#include <netinet/in.h>\nint main(void) { struct ip_mreqn a; return sizeof(a)==0; }" HAVE_STRUCT_IP_MREQN)
otp_inet_probe_source("#include <sys/types.h>\n#include <sys/socket.h>\n#include <netinet/in.h>\nint main(void) { struct ip_mreq request; int options[] = {IP_MULTICAST_IF, IP_MULTICAST_TTL, IP_MULTICAST_LOOP, IP_ADD_MEMBERSHIP, IP_DROP_MEMBERSHIP}; return sizeof(request)==0 || sizeof(options)==0; }" HAVE_MULTICAST_SUPPORT)
otp_inet_probe_source("#include <sys/types.h>\n#include <sys/socket.h>\nint main(void) { struct sockaddr a; return sizeof(a.sa_len)==0; }" HAVE_SA_LEN)
if(NOT OTP_INET_HAVE_SA_LEN)
    string(APPEND _inet_config "#define NO_SA_LEN 1\n")
endif()
foreach(_member IN ITEMS ifr_hwaddr ifr_enaddr)
    string(TOUPPER "${_member}" _name)
    otp_inet_probe_source("#include <sys/types.h>\n#include <sys/socket.h>\n#include <net/if.h>\nint main(void) { struct ifreq a; return sizeof(a.${_member})==0; }" "HAVE_STRUCT_IFREQ_${_name}")
endforeach()
check_include_file(netinet/sctp.h OTP_INET_HAVE_SCTP_H)
if(OTP_INET_HAVE_SCTP_H)
    find_library(OTP_SCTP_LIBRARY NAMES sctp REQUIRED)
    set(CMAKE_REQUIRED_LIBRARIES "${OTP_SCTP_LIBRARY}")
    string(APPEND _inet_config "#define HAVE_SCTP_H 1\n")
    foreach(_function IN ITEMS bindx peeloff getladdrs freeladdrs getpaddrs freepaddrs connectx)
        string(TOUPPER "${_function}" _name)
        otp_inet_probe_symbol("sctp_${_function}" "sys/types.h;sys/socket.h;netinet/sctp.h" "HAVE_SCTP_${_name}")
    endforeach()
    if(NOT OTP_INET_HAVE_SCTP_BINDX)
        message(FATAL_ERROR "Selected libsctp lacks sctp_bindx")
    endif()
    foreach(_symbol IN ITEMS SCTP_ABORT SCTP_ADDR_CONFIRMED SCTP_ADDR_OVER SCTP_BOUND
            SCTP_CLOSED SCTP_COOKIE_ECHOED SCTP_COOKIE_WAIT SCTP_DELAYED_ACK_TIME SCTP_EMPTY
            SCTP_EOF SCTP_ESTABLISHED SCTP_LISTEN SCTP_SHUTDOWN_ACK_SENT SCTP_SHUTDOWN_PENDING
            SCTP_SHUTDOWN_RECEIVED SCTP_SHUTDOWN_SENT SCTP_UNCONFIRMED SCTP_UNORDERED)
        otp_inet_probe_symbol("${_symbol}" "sys/types.h;sys/socket.h;netinet/sctp.h" "HAVE_DECL_${_symbol}")
    endforeach()
    foreach(_record IN ITEMS "sctp_paddrparams;spp_flags" "sctp_paddrparams;spp_pathmtu"
            "sctp_paddrparams;spp_sackdelay" "sctp_remote_error;sre_data" "sctp_send_failed;ssf_data")
        list(GET _record 0 _struct)
        list(GET _record 1 _member)
        string(TOUPPER "HAVE_STRUCT_${_struct}_${_member}" _name)
        otp_inet_probe_source("#include <sys/types.h>\n#include <sys/socket.h>\n#include <netinet/sctp.h>\nint main(void) { struct ${_struct} a; (void)a.${_member}; return 0; }" "${_name}")
    endforeach()
    string(APPEND _inet_config "#define HAVE_GCC_DIAG_IGNORE_WADDRESS_OF_PACKED_MEMBER 1\n")
endif()
set(CMAKE_REQUIRED_LIBRARIES BEAM::RuntimeStatic BEAM::NIF)
unset(OTP_INET_HAS_PACKET_API CACHE)
check_c_source_compiles("#include <beam/native.h>\nint main(void) { int state=0; return beam_packet_length(BEAM_PACKET_RAW, \"\", 0, 0, 0, 0, &state); }" OTP_INET_HAS_PACKET_API)
if(NOT OTP_INET_HAS_PACKET_API)
    message(FATAL_ERROR "OTP protocol drivers require the public beam_packet SDK interface")
endif()
cmake_pop_check_state()
file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/otp_inet_config.h"
    CONTENT "${_inet_config}" @ONLY)
