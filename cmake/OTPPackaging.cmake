# An upstream Windows NSIS installer over the independently assembled OTP tree.
include_guard(GLOBAL)
if(NOT WIN32)
    return()
endif()
set(OTP_NSIS_EXECUTABLE "" CACHE FILEPATH "Explicit NSIS 3 makensis executable")
set(OTP_VC_REDIST_EXECUTABLE "" CACHE FILEPATH "Explicit matching Release VC redistributable executable")
set(OTP_VC_REDIST_DLL_NAME "vcruntime140.dll" CACHE STRING "VC redistributable runtime DLL used by upstream NSIS detection")
set(OTP_VC_REDIST_DLL_VERSION "" CACHE STRING "VC redistributable version; empty reads the selected executable")
set(OTP_PACKAGE_DIRECTORY "${PROJECT_BINARY_DIR}/packages")
set(OTP_PACKAGE_STAGE "${OTP_INTERNAL_ROOT}/packaging")
if(BEAM_SDK_ARCHITECTURE STREQUAL "x86")
    set(OTP_PACKAGE_WINTYPE win64)
    set(OTP_PACKAGE_REDIST_NAME vcredist_x64.exe)
elseif(BEAM_SDK_ARCHITECTURE STREQUAL "arm")
    set(OTP_PACKAGE_WINTYPE arm64)
    set(OTP_PACKAGE_REDIST_NAME vcredist_arm64.exe)
else()
    message(FATAL_ERROR "No Windows package mapping for selected SDK architecture")
endif()
set(_otp_version_components ${PROJECT_VERSION_MAJOR} ${PROJECT_VERSION_MINOR} ${PROJECT_VERSION_PATCH} ${PROJECT_VERSION_TWEAK})
list(LENGTH _otp_version_components _otp_version_count)
while(_otp_version_count LESS 4)
    list(APPEND _otp_version_components 0)
    list(LENGTH _otp_version_components _otp_version_count)
endwhile()
list(JOIN _otp_version_components . OTP_PACKAGE_VERSION_LONG)
string(TIMESTAMP OTP_PACKAGE_YEAR "%Y" UTC)
configure_file("${CMAKE_CURRENT_LIST_DIR}/templates/package_windows.cmake.in"
    "${OTP_INTERNAL_ROOT}/packaging/build.cmake" @ONLY)
add_custom_target(otp_installer
    COMMAND "${CMAKE_COMMAND}" -P "${OTP_INTERNAL_ROOT}/packaging/build.cmake"
    DEPENDS otp_release
    COMMENT "Packaging the OTP Windows installer using upstream NSIS" VERBATIM)
