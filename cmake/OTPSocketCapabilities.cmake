# Socket services discover their platform contract without VM configuration.
if(WIN32)
    include(CheckCSourceCompiles)
    check_c_source_compiles("#include <winsock2.h>\n#include <ws2tcpip.h>\nint main(void) { socklen_t n = 0; _Static_assert(sizeof(n) == sizeof(int), \"Winsock length\"); return n; }"
        OTP_SOCKET_HAVE_SOCKLEN_T)
    if(NOT OTP_SOCKET_HAVE_SOCKLEN_T)
        message(FATAL_ERROR "Windows sockets require the Windows SDK socklen_t type")
    endif()
    file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/otp_socket_config.h" CONTENT
        "/* Windows socket capabilities and OTP service policy. */\n#define ESOCK_ENABLE 1\n#define ESOCK_COUNTER_SIZE 64\n#define ESOCK_USE_EXTENDED_ERROR_INFO 1\n#define ESOCK_USE_SOCKET_REGISTRY 1\n#define ESOCK_VERBOSE_MTX_NAMES 1\n#define HAVE_SOCKLEN_T 1\n#define HAVE_SDKDDKVER_H 1\n#define HAVE_IN6 1\n#define HAVE_IN6ADDR_ANY 1\n#define HAVE_IN6ADDR_LOOPBACK 1\n#define HAVE_GETADDRINFO 1\n#define HAVE_GETNAMEINFO 1\n#define HAVE_STRFTIME 1\n#define NO_SA_LEN 1\n#define SIZEOF_INT 4\n#define SIZEOF_TIME_T 8\n#define SIZEOF_SUSECONDS_T 4\n" @ONLY)
    return()
endif()
include(CMakePushCheckState)
include(CheckIncludeFile)
include(CheckIncludeFiles)
include(CheckSymbolExists)
include(CheckCSourceCompiles)
include(CheckCCompilerFlag)
include(CheckTypeSize)
cmake_push_check_state(RESET)
set(CMAKE_REQUIRED_DEFINITIONS -D_GNU_SOURCE -D_FILE_OFFSET_BITS=64)
set(_socket_config "/* OTP-owned socket platform probes and service policy. */\n")
# These are product policies, not capabilities inferred from system headers.
string(APPEND _socket_config
    "#define ESOCK_ENABLE 1\n#define ESOCK_COUNTER_SIZE 64\n"
    "#define ESOCK_USE_EXTENDED_ERROR_INFO 1\n"
    "#define ESOCK_USE_SOCKET_REGISTRY 1\n#define ESOCK_VERBOSE_MTX_NAMES 1\n")
macro(otp_socket_probe_symbol symbol headers define)
    check_symbol_exists("${symbol}" "${headers}" "OTP_SOCKET_${define}")
    if(OTP_SOCKET_${define})
        string(APPEND _socket_config "#define ${define} 1\n")
    endif()
endmacro()
macro(otp_socket_probe_source source define)
    check_c_source_compiles("${source}" "OTP_SOCKET_${define}")
    if(OTP_SOCKET_${define})
        string(APPEND _socket_config "#define ${define} 1\n")
    endif()
endmacro()
foreach(_header IN ITEMS unistd.h sys/uio.h sys/un.h sys/ioctl.h sys/sockio.h
        net/if_dl.h netpacket/packet.h ifaddrs.h arpa/nameser.h sched.h setns.h dlfcn.h)
    string(TOUPPER "${_header}" _name)
    string(REGEX REPLACE "[/.-]" "_" _name "${_name}")
    check_include_file("${_header}" "OTP_SOCKET_HAVE_${_name}")
    if(OTP_SOCKET_HAVE_${_name})
        string(APPEND _socket_config "#define HAVE_${_name} 1\n")
    endif()
endforeach()
foreach(_required UNISTD_H SYS_UIO_H SYS_IOCTL_H SYS_UN_H)
    if(NOT OTP_SOCKET_HAVE_${_required})
        message(FATAL_ERROR "OTP Linux sockets require ${_required}")
    endif()
endforeach()
check_include_files("time.h;linux/errqueue.h" OTP_SOCKET_HAVE_LINUX_ERRQUEUE_H)
if(OTP_SOCKET_HAVE_LINUX_ERRQUEUE_H)
    string(APPEND _socket_config "#define HAVE_LINUX_ERRQUEUE_H 1\n")
endif()
foreach(_function IN ITEMS getaddrinfo getnameinfo getprotoent setprotoent endprotoent)
    string(TOUPPER "${_function}" _name)
    otp_socket_probe_symbol("${_function}" "sys/types.h;sys/socket.h;netdb.h" "HAVE_${_name}")
endforeach()
otp_socket_probe_symbol(getifaddrs "sys/types.h;ifaddrs.h" HAVE_GETIFADDRS)
foreach(_function IN ITEMS if_nameindex if_freenameindex if_nametoindex if_indextoname)
    string(TOUPPER "${_function}" _name)
    otp_socket_probe_symbol("${_function}" "net/if.h" "HAVE_${_name}")
endforeach()
foreach(_function IN ITEMS recvmmsg sendmmsg)
    string(TOUPPER "${_function}" _name)
    otp_socket_probe_symbol("${_function}" "sys/types.h;sys/socket.h" "HAVE_${_name}")
endforeach()
if(APPLE)
    string(APPEND _socket_config "#define __DARWIN__ 1\n")
    check_symbol_exists(sendfile "sys/types.h;sys/socket.h;sys/uio.h" OTP_SOCKET_HAVE_DARWIN_SENDFILE)
    if(OTP_SOCKET_HAVE_DARWIN_SENDFILE)
        string(APPEND _socket_config "#define HAVE_SENDFILE 1\n")
    endif()
else()
    otp_socket_probe_symbol(sendfile "sys/types.h;sys/sendfile.h" HAVE_SENDFILE)
endif()
otp_socket_probe_symbol(setns "sched.h" HAVE_SETNS)
otp_socket_probe_symbol(strftime "time.h" HAVE_STRFTIME)
otp_socket_probe_symbol(localtime_r "time.h" HAVE_LOCALTIME_R)
set(CMAKE_REQUIRED_LIBRARIES "${CMAKE_DL_LIBS}")
otp_socket_probe_symbol(dlopen "dlfcn.h" HAVE_DLOPEN)
unset(CMAKE_REQUIRED_LIBRARIES)
foreach(_symbol IN ITEMS in6addr_any in6addr_loopback IN6ADDR_ANY_INIT IN6ADDR_LOOPBACK_INIT)
    string(TOUPPER "${_symbol}" _name)
    otp_socket_probe_symbol("${_symbol}" "sys/types.h;sys/socket.h;netinet/in.h" "HAVE_${_name}")
    if(OTP_SOCKET_HAVE_${_name})
        string(APPEND _socket_config "#define HAVE_DECL_${_name} 1\n")
    endif()
endforeach()
otp_socket_probe_source("#include <sys/types.h>\n#include <sys/socket.h>\nint main(void) { socklen_t n=0; return (int)n; }" HAVE_SOCKLEN_T)
otp_socket_probe_source("#include <netinet/in.h>\nint main(void) { struct in6_addr a; return sizeof(a)!=16; }" HAVE_IN6)
otp_socket_probe_source("#include <sys/un.h>\nint main(void) { struct sockaddr_un a; return sizeof(a.sun_path)==0; }" HAVE_STRUCT_SOCKADDR_UN_SUN_PATH)
otp_socket_probe_source("#include <sys/types.h>\n#include <sys/socket.h>\nint main(void) { struct sockaddr a; return sizeof(a.sa_len)==0; }" HAVE_SA_LEN)
if(NOT OTP_SOCKET_HAVE_SA_LEN)
    string(APPEND _socket_config "#define NO_SA_LEN 1\n")
endif()
foreach(_field IN ITEMS "ifr_hwaddr;HWADDR" "ifr_enaddr;ENADDR" "ifr_map;IFMAP"
        "ifr_ifindex;IFINDEX" "ifr_index;INDEX")
    list(GET _field 0 _member)
    list(GET _field 1 _name)
    otp_socket_probe_source("#include <sys/types.h>\n#include <sys/socket.h>\n#include <net/if.h>\nint main(void) { struct ifreq a; (void)a.${_member}; return 0; }" "ESOCK_USE_${_name}")
endforeach()
set(CMAKE_EXTRA_INCLUDE_FILES sys/types.h sys/time.h)
foreach(_type IN ITEMS int time_t suseconds_t)
    string(TOUPPER "${_type}" _name)
    check_type_size("${_type}" "OTP_SOCKET_SIZEOF_${_name}" LANGUAGE C)
    if(NOT OTP_SOCKET_SIZEOF_${_name})
        message(FATAL_ERROR "Cannot determine socket field width for ${_type}")
    endif()
    string(APPEND _socket_config "#define SIZEOF_${_name} ${OTP_SOCKET_SIZEOF_${_name}}\n")
endforeach()
unset(CMAKE_EXTRA_INCLUDE_FILES)

check_include_file(netinet/sctp.h OTP_SOCKET_HAVE_SCTP_H)
if(OTP_SOCKET_HAVE_SCTP_H)
    find_library(OTP_SCTP_LIBRARY NAMES sctp REQUIRED)
    set(CMAKE_REQUIRED_LIBRARIES "${OTP_SCTP_LIBRARY}")
    string(APPEND _socket_config "#define HAVE_SCTP_H 1\n")
    foreach(_function IN ITEMS bindx peeloff getladdrs freeladdrs getpaddrs freepaddrs connectx)
        string(TOUPPER "${_function}" _name)
        otp_socket_probe_symbol("sctp_${_function}" "sys/types.h;sys/socket.h;netinet/sctp.h" "HAVE_SCTP_${_name}")
    endforeach()
    if(NOT OTP_SOCKET_HAVE_SCTP_BINDX)
        message(FATAL_ERROR "Selected libsctp lacks sctp_bindx")
    endif()
    foreach(_symbol IN ITEMS SCTP_ABORT SCTP_ADDR_OVER SCTP_BOUND SCTP_CLOSED SCTP_COOKIE_ECHOED
            SCTP_COOKIE_WAIT SCTP_EMPTY SCTP_EOF SCTP_ESTABLISHED SCTP_LISTEN SCTP_SHUTDOWN_ACK_SENT
            SCTP_SHUTDOWN_PENDING SCTP_SHUTDOWN_RECEIVED SCTP_SHUTDOWN_SENT SCTP_UNORDERED
            SCTPS_BOUND SCTPS_COOKIE_ECHOED SCTPS_COOKIE_WAIT SCTPS_ESTABLISHED SCTPS_IDLE SCTPS_LISTEN
            SCTPS_SHUTDOWN_ACK_SENT SCTPS_SHUTDOWN_PENDING SCTPS_SHUTDOWN_RECEIVED SCTPS_SHUTDOWN_SENT)
        otp_socket_probe_symbol("${_symbol}" "sys/types.h;sys/socket.h;netinet/sctp.h" "HAVE_DECL_${_symbol}")
    endforeach()
    foreach(_field IN ITEMS
            "sctp_assoc_stats;sas_assoc_id" "sctp_assoc_stats;sas_ipackets"
            "sctp_assoc_stats;sas_obs_rto_ipaddr" "sctp_assoc_stats;sas_opackets" "sctp_assoc_stats;sas_outofseqtsns"
            "sctp_event_subscribe;sctp_assoc_reset_event" "sctp_event_subscribe;sctp_authentication_event"
            "sctp_event_subscribe;sctp_sender_dry_event" "sctp_event_subscribe;sctp_stream_change_event"
            "sctp_event_subscribe;sctp_stream_reset_event"
            "sctp_paddrparams;spp_dscp" "sctp_paddrparams;spp_flags" "sctp_paddrparams;spp_ipv6_flowlabel"
            "sctp_paddrparams;spp_pathmtu" "sctp_paddrparams;spp_sackdelay"
            "sctp_pdapi_event;pdapi_seq" "sctp_pdapi_event;pdapi_stream" "sctp_remote_error;sre_data"
            "sctp_send_failed;ssf_data" "sctp_send_failed_event;ssfe_data"
            "sctp_stream_reset_event;strreset_list" "sctp_stream_reset_event;strreset_stream_list")
        list(GET _field 0 _struct)
        list(GET _field 1 _member)
        string(TOUPPER "HAVE_STRUCT_${_struct}_${_member}" _name)
        otp_socket_probe_source("#include <sys/types.h>\n#include <sys/socket.h>\n#include <netinet/sctp.h>\nint main(void) { struct ${_struct} a; (void)a.${_member}; return 0; }" "${_name}")
    endforeach()
    check_c_compiler_flag(-Waddress-of-packed-member OTP_SOCKET_PACKED_MEMBER_DIAGNOSTIC)
    if(OTP_SOCKET_PACKED_MEMBER_DIAGNOSTIC)
        string(APPEND _socket_config "#define HAVE_GCC_DIAG_IGNORE_WADDRESS_OF_PACKED_MEMBER 1\n")
    endif()
endif()
cmake_pop_check_state()
file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/otp_socket_config.h"
    CONTENT "${_socket_config}" @ONLY)
