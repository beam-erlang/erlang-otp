# Terminal capabilities come from the product's host toolchain, not VM config.h.
if(WIN32)
    file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/otp_tty_config.h"
        CONTENT "/* Native Windows console support. */\n#define HAVE_SETLOCALE 1\n" @ONLY)
    return()
endif()
include(CheckIncludeFile)
include(CheckIncludeFiles)
include(CheckSymbolExists)
include(CheckCSourceCompiles)
set(CURSES_NEED_NCURSES TRUE)
find_package(Curses REQUIRED)
set(CMAKE_REQUIRED_INCLUDES ${CURSES_INCLUDE_DIRS})
set(CMAKE_REQUIRED_LIBRARIES ${CURSES_LIBRARIES})
check_include_files("ncurses/curses.h;ncurses/term.h" HAVE_NCURSES_CURSES_H)
check_include_file(curses.h HAVE_CURSES_H)
check_include_files("curses.h;term.h" HAVE_TERM_H)
if(HAVE_NCURSES_CURSES_H)
    set(_terminal_headers "#include <ncurses/curses.h>\n#include <ncurses/term.h>")
elseif(HAVE_CURSES_H AND HAVE_TERM_H)
    set(_terminal_headers "#include <curses.h>\n#include <term.h>")
else()
    message(FATAL_ERROR "OTP terminal support requires curses and terminfo headers")
endif()
check_c_source_compiles("${_terminal_headers}\nint main(void) { int error; return setupterm(0, 1, &error); }" HAVE_TERMCAP)
unset(CMAKE_REQUIRED_INCLUDES)
unset(CMAKE_REQUIRED_LIBRARIES)
if(NOT HAVE_TERMCAP)
    message(FATAL_ERROR "OTP terminal support requires the terminfo library")
endif()
check_include_file(sys/uio.h HAVE_SYS_UIO_H)
check_include_file(poll.h HAVE_POLL_H)
check_include_file(langinfo.h HAVE_LANGINFO_H)
check_symbol_exists(setlocale locale.h HAVE_SETLOCALE)
if(HAVE_LANGINFO_H)
    check_symbol_exists(nl_langinfo langinfo.h HAVE_NL_LANGINFO)
endif()
set(_tty_config "/* Generated OTP terminal capabilities; no VM-private configuration. */\n")
foreach(_capability IN ITEMS HAVE_NCURSES_CURSES_H HAVE_CURSES_H HAVE_TERM_H
        HAVE_TERMCAP HAVE_SYS_UIO_H HAVE_POLL_H HAVE_LANGINFO_H HAVE_SETLOCALE HAVE_NL_LANGINFO)
    if(${_capability})
        string(APPEND _tty_config "#define ${_capability} 1\n")
    endif()
endforeach()
file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/otp_tty_config.h"
    CONTENT "${_tty_config}" @ONLY)
