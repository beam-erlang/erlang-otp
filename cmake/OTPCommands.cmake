# Ordinary OTP command support. None of these targets links to VM internals.
if(WIN32)
    include("${CMAKE_CURRENT_LIST_DIR}/OTPWindowsCommands.cmake")
    return()
endif()
include(CheckIncludeFile)
include(CheckSymbolExists)
include(CheckTypeSize)
include(CheckCSourceCompiles)
find_package(Threads REQUIRED)

set(_native_config_dir "${PROJECT_BINARY_DIR}/generated/command-support")
foreach(_type IN ITEMS char short int long "long long" "void *")
    if(_type STREQUAL "void *")
        set(_name VOID_P)
    else()
        string(TOUPPER "${_type}" _name)
        string(REPLACE " " "_" _name "${_name}")
    endif()
    check_type_size("${_type}" SIZEOF_${_name})
endforeach()
foreach(_header IN ITEMS sys/time.h sys/select.h sys/uio.h pthread.h syslog.h unistd.h stdlib.h sys/ioctl.h pty.h utmp.h)
    string(TOUPPER "${_header}" _name)
    string(REPLACE "/" "_" _name "${_name}")
    string(REPLACE "." "_" _name "${_name}")
    check_include_file("${_header}" HAVE_${_name})
endforeach()
set(CMAKE_REQUIRED_DEFINITIONS -D_GNU_SOURCE)
check_symbol_exists(setsid "unistd.h" HAVE_SETSID)
check_symbol_exists(inet_pton "arpa/inet.h" HAVE_INET_PTON)
check_symbol_exists(in6addr_any "netinet/in.h" HAVE_IN6ADDR_ANY)
check_symbol_exists(in6addr_loopback "netinet/in.h" HAVE_IN6ADDR_LOOPBACK)
check_symbol_exists(IPV6_V6ONLY "netinet/in.h" HAVE_DECL_IPV6_V6ONLY)
check_c_source_compiles("#include <netinet/in.h>\nint main(void) { struct sockaddr_in6 s; return sizeof(s) == 0; }" HAVE_IN6)
check_symbol_exists(writev "sys/uio.h" HAVE_WRITEV)
check_symbol_exists(sysconf "unistd.h" HAVE_SYSCONF)
check_symbol_exists(strerror "string.h" HAVE_STRERROR)
check_symbol_exists(flockfile "stdio.h" HAVE_FLOCKFILE)
check_symbol_exists(putc_unlocked "stdio.h" HAVE_PUTC_UNLOCKED)
check_symbol_exists(fwrite_unlocked "stdio.h" HAVE_FWRITE_UNLOCKED)
check_symbol_exists(isfinite "math.h" HAVE_ISFINITE)
# socklen_t requires socket headers rather than the default type-probe includes.
check_c_source_compiles("#include <sys/socket.h>\nint main(void) { socklen_t n = 0; return n; }" HAVE_SOCKLEN_T)
check_c_source_compiles("#include <netdb.h>
int main(void) { struct hostent h, *p; char b[1024]; int e;
  int r = gethostbyname_r(\"localhost\", &h, b, sizeof(b), &p, &e);
  return r + gethostbyaddr_r(b, 4, AF_INET, &h, b, sizeof(b), &p, &e); }" HAVE_GETHOSTBYNAME_R)
check_symbol_exists(posix_openpt "stdlib.h;fcntl.h" HAVE_POSIX_OPENPT)
check_symbol_exists(grantpt "stdlib.h" HAVE_GRANTPT)
check_symbol_exists(unlockpt "stdlib.h" HAVE_UNLOCKPT)
check_symbol_exists(ptsname "stdlib.h" HAVE_PTSNAME)
check_symbol_exists(clock_gettime "time.h" HAVE_CLOCK_GETTIME)
check_symbol_exists(vsyslog "syslog.h" HAVE_VSYSLOG)
if(HAVE_POSIX_OPENPT AND HAVE_GRANTPT AND HAVE_UNLOCKPT AND HAVE_PTSNAME)
    set(HAVE_WORKING_POSIX_OPENPT 1)
endif()
if(HAVE_CLOCK_GETTIME)
    set(OS_MONOTONIC_TIME_USING_CLOCK_GETTIME 1)
endif()
unset(CMAKE_REQUIRED_DEFINITIONS)
# Match erl_interface's retained configure defaults and compiler capabilities.
# Without these probes, its threaded socket table silently selects a different
# implementation even on a compiler that supports the upstream atomic path.
set(OTP_EI_ATOMIC_SIZES 0)
foreach(_width IN ITEMS 4 8)
    math(EXPR _bits "${_width} * 8")
    check_c_source_compiles("#include <stdint.h>
int main(void) {
  uint${_bits}_t value=0, expected=0;
  __atomic_store_n(&value, 1, __ATOMIC_RELEASE);
  expected=__atomic_load_n(&value, __ATOMIC_ACQUIRE);
  return !__atomic_compare_exchange_n(&value, &expected, 2, 0,
      __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
}" OTP_EI_ATOMIC_${_width})
    if(OTP_EI_ATOMIC_${_width})
        math(EXPR OTP_EI_ATOMIC_SIZES "${OTP_EI_ATOMIC_SIZES} | ${_width}")
    endif()
endforeach()
if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64|i[3-6]86|x86)$")
    set(HAVE_UNALIGNED_WORD_ACCESS 1)
endif()
configure_file("${PROJECT_SOURCE_DIR}/cmake/command_config.h.in" "${_native_config_dir}/config.h")
file(CONFIGURE OUTPUT "${_native_config_dir}/erl_int_sizes_config.h" CONTENT
    "/* Standalone command formatter sizes, probed by CMake. */\n#define SIZEOF_CHAR ${SIZEOF_CHAR}\n#define SIZEOF_SHORT ${SIZEOF_SHORT}\n#define SIZEOF_INT ${SIZEOF_INT}\n#define SIZEOF_LONG ${SIZEOF_LONG}\n#define SIZEOF_LONG_LONG ${SIZEOF_LONG_LONG}\n#define SIZEOF_VOID_P ${SIZEOF_VOID_P}\n" @ONLY)

set(_ei "${PROJECT_SOURCE_DIR}/lib/erl_interface")
set(_ei_sources)
foreach(_part IN ITEMS connect decode encode epmd misc global)
    file(GLOB _part_sources CONFIGURE_DEPENDS "${_ei}/src/${_part}/*.c")
    list(APPEND _ei_sources ${_part_sources})
endforeach()
# Upstream explicitly compiles this retained standalone digest in ERL_INTERFACE
# mode. It neither includes sys.h nor obtains any VM implementation dependency.
list(APPEND _ei_sources "${PROJECT_SOURCE_DIR}/erts/emulator/beam/erl_md5.c")
foreach(_variant IN ITEMS ei ei_st)
    add_library(otp_${_variant} STATIC ${_ei_sources})
    set_target_properties(otp_${_variant} PROPERTIES OUTPUT_NAME "${_variant}" POSITION_INDEPENDENT_CODE ON)
    target_compile_definitions(otp_${_variant} PRIVATE ERL_INTERFACE EI_NO_DEPR_WARN HAVE_CONFIG_H _GNU_SOURCE)
    target_include_directories(otp_${_variant} PUBLIC "${_ei}/include" PRIVATE
        "${_native_config_dir}" "${PROJECT_SOURCE_DIR}/erts/emulator/beam")
    foreach(_part IN ITEMS connect encode decode misc epmd global)
        target_include_directories(otp_${_variant} PRIVATE "${_ei}/src/${_part}")
    endforeach()
    target_link_libraries(otp_${_variant} PUBLIC m)
endforeach()
target_compile_definitions(otp_ei PUBLIC _REENTRANT)
target_link_libraries(otp_ei PUBLIC Threads::Threads)

# Standalone formatting support retained with OTP's command sources. This is
# not the VM's printf implementation obtained via a private dynamic symbol.
add_library(otp_command_format STATIC
    "${PROJECT_SOURCE_DIR}/erts/lib_src/common/erl_printf.c"
    "${PROJECT_SOURCE_DIR}/erts/lib_src/common/erl_printf_format.c")
target_include_directories(otp_command_format PUBLIC
    "${PROJECT_SOURCE_DIR}/erts/include/internal" PRIVATE "${_native_config_dir}")
target_compile_definitions(otp_command_format PRIVATE HAVE_CONFIG_H _GNU_SOURCE)
target_link_libraries(otp_command_format PUBLIC m)

foreach(_command IN ITEMS erlc escript ct_run erlexec dialyzer typer)
    set(_command_target "otp_${_command}")
    if(_command STREQUAL dialyzer)
        set(_command_target otp_dialyzer_command)
    endif()
    add_executable(${_command_target} "${PROJECT_SOURCE_DIR}/erts/etc/common/${_command}.c")
    set_target_properties(${_command_target} PROPERTIES OUTPUT_NAME "${_command}")
    target_include_directories(${_command_target} PRIVATE "${_native_config_dir}")
    target_compile_definitions(${_command_target} PRIVATE HAVE_CONFIG_H _GNU_SOURCE)
    target_link_libraries(${_command_target} PRIVATE otp_command_format)
    if(NOT _command STREQUAL erlexec)
        install(TARGETS ${_command_target} RUNTIME DESTINATION bin)
    endif()
    install(TARGETS ${_command_target} RUNTIME DESTINATION "erts-${_erts_version}/bin")
endforeach()
target_compile_definitions(otp_erlexec PRIVATE OTP_SYSTEM_VERSION="${PROJECT_VERSION_MAJOR}")
