foreach(_script IN ITEMS erl.src.src Install.src)
    set(_input "${PROJECT_SOURCE_DIR}/erts/etc/unix/${_script}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_input}")
    file(READ "${_input}" _contents)
    if(_script STREQUAL Install.src)
        set(_version_tokens I_VSN)
    else()
        set(_version_tokens VSN)
    endif()
    foreach(_token IN LISTS _version_tokens)
        string(REPLACE "%${_token}%" "${_erts_version}" _contents "${_contents}")
    endforeach()
    string(REPLACE "%I_SYSTEM_VSN%" "${PROJECT_VERSION_MAJOR}" _contents "${_contents}")
    string(REPLACE "%EMULATOR%" "beam" _contents "${_contents}")
    string(REPLACE "%EMULATOR_NUMBER%" "" _contents "${_contents}")
    if(_script STREQUAL Install.src)
        set(_output Install)
        set(_destination .)
    else()
        set(_output erl.src)
        set(_destination "erts-${_erts_version}/bin")
    endif()
    file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/${_output}" CONTENT "${_contents}" @ONLY)
    install(PROGRAMS "${PROJECT_BINARY_DIR}/generated/${_output}" DESTINATION "${_destination}")
endforeach()
