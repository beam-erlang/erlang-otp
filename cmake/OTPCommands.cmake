    add_executable(otp_${_command} ${_source})
    set_target_properties(otp_${_command} PROPERTIES OUTPUT_NAME "${_command}")
    target_include_directories(otp_${_command} PRIVATE "${_native_config_dir}")
    target_compile_definitions(otp_${_command} PRIVATE HAVE_CONFIG_H _GNU_SOURCE)
    target_link_libraries(otp_${_command} PRIVATE otp_command_format)
    install(TARGETS otp_${_command} RUNTIME DESTINATION "erts-${_erts_version}/bin")
