# Each producer owns an explicit set of leaves, never a whole shared tree.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/OTPExecution.cmake")

function(_otp_owned_path output root path)
    if(NOT IS_ABSOLUTE "${root}" OR NOT IS_ABSOLUTE "${path}")
        message(FATAL_ERROR "Staging roots and outputs must be absolute: ${root}, ${path}")
    endif()
    cmake_path(NORMAL_PATH root)
    cmake_path(NORMAL_PATH path)
    cmake_path(IS_PREFIX root "${path}" NORMALIZE _inside)
    if(NOT _inside OR path STREQUAL root)
        message(FATAL_ERROR "Owned output escapes staging root: ${path}")
    endif()
    set(${output} "${path}" PARENT_SCOPE)
endfunction()

function(_otp_check_output_parents root path)
    cmake_path(NORMAL_PATH root)
    get_filename_component(_parent "${path}" DIRECTORY)
    while(TRUE)
        if(IS_SYMLINK "${_parent}")
            message(FATAL_ERROR "Staging output ancestor is a symlink: ${_parent}")
        elseif(EXISTS "${_parent}" AND NOT IS_DIRECTORY "${_parent}")
            message(FATAL_ERROR "Staging output ancestor is not a directory: ${_parent}")
        endif()
        if(_parent STREQUAL root)
            break()
        endif()
        get_filename_component(_next "${_parent}" DIRECTORY)
        set(_parent "${_next}")
    endwhile()
endfunction()

function(_otp_current_outputs output root)
    cmake_parse_arguments(PARSE_ARGV 2 P "" "" "")
    set(_current)
    foreach(_path IN LISTS P_UNPARSED_ARGUMENTS)
        _otp_owned_path(_path "${root}" "${_path}")
        _otp_check_output_parents("${root}" "${_path}")
        if(IS_DIRECTORY "${_path}" AND NOT IS_SYMLINK "${_path}")
            message(FATAL_ERROR "Staging output leaf is a directory: ${_path}")
        endif()
        if(_path IN_LIST _current)
            message(FATAL_ERROR "Duplicate staging output: ${_path}")
        endif()
        string(REPLACE ";" "\\;" _item "${_path}")
        list(APPEND _current "${_item}")
    endforeach()
    set(${output} "${_current}" PARENT_SCOPE)
endfunction()

function(_otp_previous_outputs output root receipt)
    set(_paths)
    if(IS_SYMLINK "${receipt}" OR IS_DIRECTORY "${receipt}")
        message(FATAL_ERROR "Staging receipt must be a regular file: ${receipt}")
    endif()
    if(EXISTS "${receipt}")
        file(READ "${receipt}" _previous)
        string(JSON _type TYPE "${_previous}")
        if(NOT _type STREQUAL ARRAY)
            message(FATAL_ERROR "Staging receipt must contain a JSON array: ${receipt}")
        endif()
        string(JSON _count LENGTH "${_previous}")
        if(_count GREATER 0)
            math(EXPR _last "${_count} - 1")
            foreach(_index RANGE ${_last})
                string(JSON _type TYPE "${_previous}" ${_index})
                if(NOT _type STREQUAL STRING)
                    message(FATAL_ERROR "Staging receipt must contain relative path strings: ${receipt}")
                endif()
                string(JSON _relative GET "${_previous}" ${_index})
                if(IS_ABSOLUTE "${_relative}")
                    message(FATAL_ERROR "Staging receipt contains an absolute path: ${_relative}")
                endif()
                _otp_owned_path(_path "${root}" "${root}/${_relative}")
                _otp_check_output_parents("${root}" "${_path}")
                string(REPLACE ";" "\\;" _item "${_path}")
                list(APPEND _paths "${_item}")
            endforeach()
        endif()
    endif()
    set(${output} "${_paths}" PARENT_SCOPE)
endfunction()

function(_otp_prune_outputs current previous)
    foreach(_path IN LISTS previous)
        # A stale leaf replaced by a real directory is no longer ours to remove.
        # A leaf symlink is removed as an entry, without following its target.
        if(NOT _path IN_LIST current AND (IS_SYMLINK "${_path}" OR
                (EXISTS "${_path}" AND NOT IS_DIRECTORY "${_path}")))
            file(REMOVE "${_path}")
        endif()
    endforeach()
endfunction()

function(otp_remove_obsolete root receipt)
    cmake_parse_arguments(PARSE_ARGV 2 P "" "" "")
    _otp_current_outputs(_current "${root}" ${P_UNPARSED_ARGUMENTS})
    _otp_previous_outputs(_previous "${root}" "${receipt}")
    _otp_prune_outputs("${_current}" "${_previous}")
endfunction()

function(otp_record_outputs root receipt)
    cmake_parse_arguments(PARSE_ARGV 2 P "" "" "")
    _otp_current_outputs(_current "${root}" ${P_UNPARSED_ARGUMENTS})
    if(IS_SYMLINK "${receipt}" OR IS_DIRECTORY "${receipt}")
        message(FATAL_ERROR "Staging receipt must be a regular file: ${receipt}")
    endif()
    set(_json "[]")
    set(_index 0)
    foreach(_output IN LISTS _current)
        file(RELATIVE_PATH _relative "${root}" "${_output}")
        string(REPLACE "\\" "\\\\" _relative "${_relative}")
        string(REPLACE "\"" "\\\"" _relative "${_relative}")
        string(REPLACE "\n" "\\n" _relative "${_relative}")
        string(REPLACE "\r" "\\r" _relative "${_relative}")
        string(REPLACE "\t" "\\t" _relative "${_relative}")
        string(JSON _json SET "${_json}" ${_index} "\"${_relative}\"")
        math(EXPR _index "${_index} + 1")
    endforeach()
    get_filename_component(_parent "${receipt}" DIRECTORY)
    file(MAKE_DIRECTORY "${_parent}")
    file(WRITE "${receipt}" "${_json}\n")
endfunction()

function(otp_stage_outputs root receipt)
    cmake_parse_arguments(PARSE_ARGV 2 S "PRUNE_ONLY" "" "SOURCES;OUTPUTS")
    list(LENGTH S_SOURCES _source_count)
    list(LENGTH S_OUTPUTS _output_count)
    if(S_UNPARSED_ARGUMENTS OR (NOT S_PRUNE_ONLY AND NOT _source_count EQUAL _output_count))
        message(FATAL_ERROR "Invalid staging source/output declaration for ${receipt}")
    endif()
    # Finish the entire preflight before copying or deleting even the first
    # output. Existing Python-generated root-relative JSON receipts are valid.
    _otp_current_outputs(_current "${root}" ${S_OUTPUTS})
    _otp_previous_outputs(_previous "${root}" "${receipt}")
    foreach(_source IN LISTS S_SOURCES)
        if(NOT EXISTS "${_source}" OR IS_DIRECTORY "${_source}")
            message(FATAL_ERROR "Staging source is not an existing file: ${_source}")
        endif()
    endforeach()

    if(NOT S_PRUNE_ONLY AND _source_count GREATER 0)
        math(EXPR _last "${_source_count} - 1")
        foreach(_index RANGE ${_last})
            list(GET S_SOURCES ${_index} _source)
            list(GET _current ${_index} _destination)
            # Resolve an input file symlink before replacing a destination leaf
            # symlink, so the copy never writes through the destination link.
            file(REAL_PATH "${_source}" _source)
            if(IS_SYMLINK "${_destination}")
                file(REMOVE "${_destination}")
            endif()
            get_filename_component(_parent "${_destination}" DIRECTORY)
            file(MAKE_DIRECTORY "${_parent}")
            file(COPY_FILE "${_source}" "${_destination}" ONLY_IF_DIFFERENT)
        endforeach()
    endif()
    _otp_prune_outputs("${_current}" "${_previous}")
    otp_record_outputs("${root}" "${receipt}" ${_current})
endfunction()

function(otp_staging_command output root receipt)
    cmake_parse_arguments(PARSE_ARGV 3 S "PRUNE_ONLY" "" "SOURCES;OUTPUTS")
    list(LENGTH S_SOURCES _source_count)
    list(LENGTH S_OUTPUTS _output_count)
    if(S_UNPARSED_ARGUMENTS OR (NOT S_PRUNE_ONLY AND NOT _source_count EQUAL _output_count))
        message(FATAL_ERROR "Invalid staging source/output declaration for ${receipt}")
    endif()
    otp_cmake_literal(_module "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
    otp_cmake_literal(_root "${root}")
    otp_cmake_literal(_receipt "${receipt}")
    set(_contents "include(${_module})\notp_stage_outputs(${_root} ${_receipt}")
    if(S_PRUNE_ONLY)
        string(APPEND _contents " PRUNE_ONLY")
    endif()
    string(APPEND _contents " SOURCES")
    foreach(_path IN LISTS S_SOURCES)
        otp_cmake_literal(_literal "${_path}")
        string(APPEND _contents " ${_literal}")
    endforeach()
    string(APPEND _contents " OUTPUTS")
    foreach(_path IN LISTS S_OUTPUTS)
        otp_cmake_literal(_literal "${_path}")
        string(APPEND _contents " ${_literal}")
    endforeach()
    string(APPEND _contents ")\n")
    string(SHA256 _identity "${_contents}")
    set(_script "${OTP_INTERNAL_ROOT}/commands/${_identity}.cmake")
    file(GENERATE OUTPUT "${_script}" CONTENT "${_contents}")
    set(${output} COMMAND "${CMAKE_COMMAND}" -P "${_script}" PARENT_SCOPE)
    set(${output}_INPUTS "${_script};${CMAKE_CURRENT_FUNCTION_LIST_FILE}" PARENT_SCOPE)
endfunction()
