# Upstream finalization reads the staged tree but writes the logical final root
# into launchers. -cross has this meaning even on an ordinary native install.

if("@CMAKE_SYSTEM_NAME@" STREQUAL "Windows")
    if(NOT "$ENV{DESTDIR}" STREQUAL "")
        message(FATAL_ERROR "Windows installation uses --prefix; DESTDIR is unsupported")
    endif()
    execute_process(COMMAND "${CMAKE_INSTALL_PREFIX}/Install.exe" -s
        WORKING_DIRECTORY "${CMAKE_INSTALL_PREFIX}" COMMAND_ERROR_IS_FATAL ANY)
    # Windows Install.exe owns native commands and boot selection; release
    # metadata is root-relative so moving the tree does not retain a stage path.
    file(READ "${CMAKE_INSTALL_PREFIX}/releases/RELEASES.src" _release_index)
    string(REPLACE "%ERL_ROOT%/" "" _release_index "${_release_index}")
    string(REPLACE "%ERL_ROOT%" "" _release_index "${_release_index}")
    file(WRITE "${CMAKE_INSTALL_PREFIX}/releases/RELEASES" "${_release_index}")
    file(REMOVE "${CMAKE_INSTALL_PREFIX}/releases/RELEASES.src")
    file(WRITE "${CMAKE_INSTALL_PREFIX}/releases/start_erl.data" "@OTP_ERTS_VERSION@ @PROJECT_VERSION_MAJOR@\n")
    execute_process(COMMAND "@OTP_INSTALL_GUARD@" "${CMAKE_INSTALL_PREFIX}" "${_otp_requested_prefix}"
        "@CMAKE_COMMAND@" "-DOTP_INSTALL_STAGE=${CMAKE_INSTALL_PREFIX}"
        "-DOTP_INSTALL_PREFIX=${_otp_requested_prefix}"
        -P "@PROJECT_SOURCE_DIR@/cmake/OTPPublishInstall.cmake"
        COMMAND_ERROR_IS_FATAL ANY)
else()
    execute_process(
        COMMAND /bin/sh ./Install -cross -minimal "${_otp_requested_prefix}"
        WORKING_DIRECTORY "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}"
        COMMAND_ERROR_IS_FATAL ANY)
    include("@PROJECT_SOURCE_DIR@/cmake/OTPPublishInstall.cmake")
    otp_publish_install("$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}"
        "$ENV{DESTDIR}${_otp_requested_prefix}")
endif()

string(REPLACE
    "${CMAKE_INSTALL_PREFIX}/" "${_otp_requested_prefix}/"
    CMAKE_INSTALL_MANIFEST_FILES "${CMAKE_INSTALL_MANIFEST_FILES}"
)
set(CMAKE_INSTALL_PREFIX "${_otp_requested_prefix}")
