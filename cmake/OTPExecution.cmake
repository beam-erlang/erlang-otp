# Literal process arguments, without a shell or a second build driver.
include_guard(GLOBAL)

function(otp_cmake_literal output value)
    set(_equals "=")
    while("${value}" MATCHES "\\]${_equals}\\]")
        string(APPEND _equals "=")
    endwhile()
    set(${output} "[${_equals}[${value}]${_equals}]" PARENT_SCOPE)
endfunction()

# Run at build time: the configuring shell need not have the build's environment.
function(otp_prepare_environment bootstrap inetrc)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E environment
        OUTPUT_VARIABLE _environment COMMAND_ERROR_IS_FATAL ANY)
    string(REGEX MATCHALL "(^|\n)[A-Za-z_][A-Za-z0-9_]*=" _names "${_environment}")
    foreach(_name IN LISTS _names)
        string(REGEX REPLACE "^\n|=$" "" _name "${_name}")
        if(_name MATCHES "^(ERL_|ERLC_|BEAM_|LD_|DYLD_)" OR
                _name MATCHES "^(ROOTDIR|BINDIR|EMU|PROGNAME|ESCRIPT_EMULATOR)$")
            unset(ENV{${_name}})
        endif()
    endforeach()
    set(ENV{ERL_INETRC} "${inetrc}")
    set(_suffix "")
    if(CMAKE_HOST_WIN32)
        set(_suffix ".exe")
    endif()
    set(ENV{ERLC_EMULATOR} "${bootstrap}/bin/erl${_suffix}")
    set(ENV{ESCRIPT_EMULATOR} "${bootstrap}/bin/erl${_suffix}")
    set(ENV{ERLC_USE_SERVER} "false")
    get_filename_component(_internal "${inetrc}" DIRECTORY)
    get_filename_component(_command "${CMAKE_SCRIPT_MODE_FILE}" NAME_WE)
    set(ENV{ERL_CRASH_DUMP} "${_internal}/crash-${_command}.dump")
endfunction()

function(_otp_process_command output directory destination arguments)
    otp_cmake_literal(_module "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
    otp_cmake_literal(_bootstrap "${OTP_BOOTSTRAP_ROOT}")
    otp_cmake_literal(_inetrc "${OTP_INTERNAL_ROOT}/bootstrap-inetrc")
    otp_cmake_literal(_directory "${directory}")
    set(_contents "include(${_module})\notp_prepare_environment(${_bootstrap} ${_inetrc})\nexecute_process(COMMAND${arguments}")
    string(APPEND _contents "\n  WORKING_DIRECTORY ${_directory}")
    if(NOT destination STREQUAL "")
        get_filename_component(_parent "${destination}" DIRECTORY)
        otp_cmake_literal(_parent "${_parent}")
        otp_cmake_literal(_destination "${destination}")
        set(_contents "file(MAKE_DIRECTORY ${_parent})\n${_contents}")
        string(APPEND _contents "\n  OUTPUT_FILE ${_destination}")
    endif()
    string(APPEND _contents "\n  COMMAND_ERROR_IS_FATAL ANY)\n")
    string(SHA256 _identity "${_contents}")
    set(_script "${OTP_INTERNAL_ROOT}/commands/${_identity}.cmake")
    file(GENERATE OUTPUT "${_script}" CONTENT "${_contents}")
    set(${output} COMMAND "${CMAKE_COMMAND}" -P "${_script}" PARENT_SCOPE)
    set(${output}_INPUTS "${_script};${CMAKE_CURRENT_FUNCTION_LIST_FILE}" PARENT_SCOPE)
endfunction()

function(otp_command output directory)
    if(ARGC LESS 3)
        message(FATAL_ERROR "otp_command requires an executable")
    endif()
    set(_arguments "")
    math(EXPR _last "${ARGC} - 1")
    foreach(_index RANGE 2 ${_last})
        otp_cmake_literal(_literal "${ARGV${_index}}")
        string(APPEND _arguments " ${_literal}")
    endforeach()
    _otp_process_command(_command "${directory}" "" "${_arguments}")
    set(${output} "${_command}" PARENT_SCOPE)
    set(${output}_INPUTS "${_command_INPUTS}" PARENT_SCOPE)
endfunction()

function(otp_capture_command output directory destination)
    if(ARGC LESS 4)
        message(FATAL_ERROR "otp_capture_command requires an executable")
    endif()
    set(_arguments "")
    math(EXPR _last "${ARGC} - 1")
    foreach(_index RANGE 3 ${_last})
        otp_cmake_literal(_literal "${ARGV${_index}}")
        string(APPEND _arguments " ${_literal}")
    endforeach()
    _otp_process_command(_command "${directory}" "${destination}" "${_arguments}")
    set(${output} "${_command}" PARENT_SCOPE)
    set(${output}_INPUTS "${_command_INPUTS}" PARENT_SCOPE)
endfunction()
