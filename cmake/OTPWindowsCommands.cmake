find_package(Threads REQUIRED)
set(_native_config_dir "${PROJECT_BINARY_DIR}/generated")
set(_etc "${PROJECT_SOURCE_DIR}/erts/etc")
set(_ei "${PROJECT_SOURCE_DIR}/lib/erl_interface")
add_library(otp_command_format STATIC
    "${PROJECT_SOURCE_DIR}/erts/lib_src/common/erl_printf.c"
    "${PROJECT_SOURCE_DIR}/erts/lib_src/common/erl_printf_format.c")
target_include_directories(otp_command_format PUBLIC "${PROJECT_SOURCE_DIR}/erts/include/internal")
target_compile_definitions(otp_command_format PRIVATE HAVE_CONFIG_H)

set(_ei_sources)
foreach(_part connect decode encode epmd misc global)
    file(GLOB _part_sources CONFIGURE_DEPENDS "${_ei}/src/${_part}/*.c")
    list(APPEND _ei_sources ${_part_sources})
endforeach()
list(APPEND _ei_sources "${PROJECT_SOURCE_DIR}/erts/emulator/beam/erl_md5.c")
foreach(_variant ei ei_st)
    add_library(otp_${_variant} STATIC ${_ei_sources})
    set_target_properties(otp_${_variant} PROPERTIES OUTPUT_NAME "${_variant}")
    target_compile_definitions(otp_${_variant} PRIVATE ERL_INTERFACE EI_NO_DEPR_WARN HAVE_CONFIG_H)
    target_include_directories(otp_${_variant} PUBLIC "${_ei}/include" PRIVATE
        "${PROJECT_SOURCE_DIR}/erts/emulator/beam")
    foreach(_part connect decode encode misc epmd global)
        target_include_directories(otp_${_variant} PRIVATE "${_ei}/src/${_part}")
    endforeach()
endforeach()
target_compile_definitions(otp_ei PUBLIC _REENTRANT)
target_link_libraries(otp_ei PUBLIC Threads::Threads)

file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/erl_version.h"
    CONTENT "#define ERLANG_VERSION \"${PROJECT_VERSION}\"\n#define ERTS_VERSION \"${_erts_version}\"\n#define ERLANG_OTP_RELEASE \"${PROJECT_VERSION_MAJOR}\"\n" @ONLY)
file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/erl_int_sizes_config.h"
    CONTENT "#define SIZEOF_CHAR 1\n#define SIZEOF_SHORT 2\n#define SIZEOF_INT 4\n#define SIZEOF_LONG 4\n#define SIZEOF_LONG_LONG 8\n#define SIZEOF_VOID_P 8\n" @ONLY)

add_library(otp_erlexec SHARED "${_etc}/common/erlexec.c" "${_etc}/win32/init_file.c"
    "${PROJECT_SOURCE_DIR}/tools/otp_win_erlexec.c")
set_target_properties(otp_erlexec PROPERTIES PREFIX "" OUTPUT_NAME erlexec)
target_compile_definitions(otp_erlexec PRIVATE HAVE_CONFIG_H OTP_PUBLIC_HOST
    OTP_SYSTEM_VERSION="${PROJECT_VERSION_MAJOR}")
target_include_directories(otp_erlexec PRIVATE "${_etc}/win32" "${PROJECT_SOURCE_DIR}/tools")
target_link_libraries(otp_erlexec PRIVATE otp_command_format shell32)
install(TARGETS otp_erlexec RUNTIME DESTINATION "erts-${_erts_version}/bin")

add_executable(otp_erl_command "${_etc}/win32/erl.c" "${_etc}/win32/init_file.c")
target_include_directories(otp_erl_command PRIVATE "${_etc}/win32")
set_target_properties(otp_erl_command PROPERTIES OUTPUT_NAME erl)
if(MINGW)
    target_link_options(otp_erl_command PRIVATE -municode)
endif()
install(TARGETS otp_erl_command RUNTIME DESTINATION bin)
install(TARGETS otp_erl_command RUNTIME DESTINATION "erts-${_erts_version}/bin")
foreach(_command erlc escript ct_run dialyzer typer heart)
    set(_target "otp_${_command}")
    if(_command STREQUAL dialyzer)
        set(_target otp_dialyzer_command)
    endif()
    add_executable(${_target} "${_etc}/common/${_command}.c")
    set_target_properties(${_target} PROPERTIES OUTPUT_NAME "${_command}")
    target_compile_definitions(${_target} PRIVATE HAVE_CONFIG_H)
    target_link_libraries(${_target} PRIVATE otp_command_format)
    if(MINGW AND NOT _command STREQUAL heart)
        target_link_options(${_target} PRIVATE -municode)
    endif()
    install(TARGETS ${_target} RUNTIME DESTINATION bin)
    install(TARGETS ${_target} RUNTIME DESTINATION "erts-${_erts_version}/bin")
endforeach()
target_link_libraries(otp_erlc PRIVATE otp_ei)
add_executable(otp_epmd erts/epmd/src/epmd.c erts/epmd/src/epmd_srv.c erts/epmd/src/epmd_cli.c)
target_compile_definitions(otp_epmd PRIVATE HAVE_CONFIG_H EPMD_PORT_NO=4369)
target_link_libraries(otp_epmd PRIVATE otp_command_format)
set_target_properties(otp_epmd PROPERTIES OUTPUT_NAME epmd)
install(TARGETS otp_epmd RUNTIME DESTINATION bin)
install(TARGETS otp_epmd RUNTIME DESTINATION "erts-${_erts_version}/bin")
add_executable(otp_erl_call "${_ei}/src/prog/erl_call.c")
target_include_directories(otp_erl_call PRIVATE "${_ei}/src/connect" "${_ei}/src/misc")
target_compile_definitions(otp_erl_call PRIVATE HAVE_CONFIG_H)
target_link_libraries(otp_erl_call PRIVATE otp_ei)
set_target_properties(otp_erl_call PROPERTIES OUTPUT_NAME erl_call)
install(TARGETS otp_erl_call RUNTIME DESTINATION bin)
install(TARGETS otp_erl_call RUNTIME DESTINATION "erts-${_erts_version}/bin")
otp_application_version(erl_interface _ei_version)
install(TARGETS otp_ei otp_ei_st ARCHIVE DESTINATION "lib/erl_interface-${_ei_version}/lib")
install(TARGETS otp_ei otp_ei_st ARCHIVE DESTINATION usr/lib)
install(FILES "${_ei}/include/ei.h" "${_ei}/include/ei_connect.h" "${_ei}/include/eicode.h"
    DESTINATION "lib/erl_interface-${_ei_version}/include")
install(FILES "${_ei}/include/ei.h" "${_ei}/include/ei_connect.h" "${_ei}/include/eicode.h"
    DESTINATION usr/include)
